def police(taille, gras=False, italique=False):
    return pygame.font.SysFont("georgia,dejavuserif,serif", taille,
                                bold=gras, italic=italique)


def dessiner_texte(ecran, texte, x, y, fonte, couleur):
    surface = fonte.render(texte, True, couleur)
    ecran.blit(surface, (x, y))
    return surface.get_height()


def dessiner_entete(ecran, sous_titre):
    dessiner_texte(ecran, "Achille et la tortue",
                    X_DEPART, 30, police(32, gras=True), COULEUR_CREME)
    dessiner_texte(ecran, sous_titre, X_DEPART, 68,
                    police(18, italique=True), COULEUR_OR_CLAIR)
    dessiner_texte(
        ecran, "Espace : démarrer / pause   —   R : recommencer   —   Échap : quitter",
        X_DEPART, 96, police(15), COULEUR_ENCRE_DOUCE)


