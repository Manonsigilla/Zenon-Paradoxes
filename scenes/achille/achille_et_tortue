class Bouton:
    """Petit bouton cliquable, dans le même esprit que le reste du projet."""

    def __init__(self, x, y, largeur, hauteur, texte, on_clic):
        self.rect = pygame.Rect(x, y, largeur, hauteur)
        self.texte = texte
        self.on_clic = on_clic
        self.actif = True

    def gerer_evenement(self, event):
        if not self.actif:
            return False
        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            if self.rect.collidepoint(event.pos):
                self.on_clic()
                return True
        return False

    def dessiner(self, ecran):
        couleur_bord = COULEUR_OR if self.actif else COULEUR_INACTIF
        couleur_texte = COULEUR_CREME if self.actif else COULEUR_ENCRE_DOUCE
        pygame.draw.rect(ecran, COULEUR_PANNEAU, self.rect, border_radius=8)
        pygame.draw.rect(ecran, couleur_bord, self.rect, width=2,
                          border_radius=8)
        surface = police(17, gras=True).render(self.texte, True, couleur_texte)
        ecran.blit(surface, surface.get_rect(center=self.rect.center))


