def dessiner_phase_resolution(ecran, etat, boutons):
    dessiner_entete(ecran, "La résolution : la course réelle, en temps continu")

    pygame.draw.line(ecran, COULEUR_ENCRE_DOUCE,
                      (X_DEPART, Y_PISTE), (X_FIN_PISTE, Y_PISTE), 2)
    pygame.draw.line(ecran, COULEUR_ENCRE_DOUCE,
                      (X_DEPART, Y_PISTE - 14), (X_DEPART, Y_PISTE + 14), 2)
    pygame.draw.line(ecran, COULEUR_OR,
                      (X_FIN_PISTE, Y_PISTE - 20), (X_FIN_PISTE, Y_PISTE + 20), 3)
    dessiner_texte(ecran, "Rattrapage réel", X_FIN_PISTE - 46, Y_PISTE - 42,
                    police(14, italique=True), COULEUR_OR_CLAIR)

    for marque in etat.marques_etapes_reel:
        x_m = x_ecran(marque)
        pygame.draw.line(ecran, COULEUR_ENCRE_DOUCE,
                          (x_m, Y_PISTE - 6), (x_m, Y_PISTE + 6), 1)

    x_tortue = x_ecran(etat.position_tortue_reel)
    x_achille = x_ecran(etat.position_achille_reel)
    _dessiner_marqueur_tortue(ecran, x_tortue, Y_PISTE)
    _dessiner_marqueur_achille(ecran, x_achille, Y_PISTE)

    _dessiner_panneau_resolution(ecran, etat)
    for b in boutons:
        b.dessiner(ecran)


def _dessiner_panneau_resolution(ecran, etat):
    panneau = pygame.Rect(X_DEPART - 20, 420, LARGEUR_PISTE_PIXELS + 40, 210)
    pygame.draw.rect(ecran, COULEUR_PANNEAU, panneau, border_radius=14)
