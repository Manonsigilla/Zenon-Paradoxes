    y += 32

    if etat.termine_reel:
        explication = (
            f"Achille rattrape la tortue à t = {temps_rattrapage():.2f} s. "
            "Contrairement à ce que suggérait le raisonnement de Zénon, "
            "une infinité d'étapes de plus en plus petites tient bien "
            "dans un temps fini : le paradoxe n'empêchait pas la réalité.")
    elif not etat.en_cours_reel and etat.numero_etape_reel == 0:
        explication = "Espace : lancer la course réelle."
    else:
        explication = (
            "Cette fois, les deux coureurs avancent en continu, à leur "
            "vraie vitesse : les étapes de Zénon se produisent d'elles-"
            "mêmes, de plus en plus vite, à l'approche du rattrapage.")
    dessiner_texte(ecran, explication, x, y,
                    police(16, italique=True), COULEUR_OR_CLAIR)


# ======================================================================
# ÉVÉNEMENTS
# ======================================================================

def gerer_evenements(etat, boutons):
    """Lit les événements Pygame. Renvoie False si l'utilisateur quitte."""
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            return False

        clique_sur_bouton = False
        for b in boutons:
            if b.gerer_evenement(event):
                clique_sur_bouton = True
                break
        if clique_sur_bouton:
            continue

        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                return False
            if event.key == pygame.K_r:
                etat.rejouer()
            if event.key == pygame.K_SPACE:
                if etat.mode == "paradoxe":
                    etat.basculer_auto()
                else:
                    etat.basculer_course_reelle()
    return True


# ======================================================================
# BOUCLE PRINCIPALE
# ======================================================================

def creer_boutons(etat):
    """Construit les deux jeux de boutons (un par phase)."""
    y = 645
    boutons_paradoxe = [
        Bouton(150, y, 190, 42, "Avancer (Espace)", etat.avancer_etape),
        Bouton(360, y, 150, 42, "Auto", etat.basculer_auto),
        Bouton(530, y, 140, 42, "Rejouer", etat.rejouer),
        Bouton(690, y, 260, 42, "Voir la résolution →", etat.passer_a_resolution),
    ]
    boutons_resolution = [
        Bouton(150, y, 260, 42, "← Revenir au paradoxe", etat.revenir_au_paradoxe),
        Bouton(430, y, 140, 42, "Rejouer", etat.rejouer),
    ]
    return boutons_paradoxe, boutons_resolution


def main():
    pygame.init()
    ecran = pygame.display.set_mode((LARGEUR_FENETRE, HAUTEUR_FENETRE))
    pygame.display.set_caption("Le paradoxe d'Achille et la tortue")
    horloge = pygame.time.Clock()

    etat = EtatSimulation()
    boutons_paradoxe, boutons_resolution = creer_boutons(etat)

    en_cours_programme = True
    while en_cours_programme:
        dt = horloge.tick(FPS) / 1000

        boutons_actifs = (boutons_paradoxe if etat.mode == "paradoxe"
                           else boutons_resolution)
        en_cours_programme = gerer_evenements(etat, boutons_actifs)
        mettre_a_jour(etat, dt)

        ecran.fill(COULEUR_FOND)
        if etat.mode == "paradoxe":
            dessiner_phase_paradoxe(ecran, etat, boutons_paradoxe)
        else:
            dessiner_phase_resolution(ecran, etat, boutons_resolution)
        pygame.display.flip()

    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    main()
